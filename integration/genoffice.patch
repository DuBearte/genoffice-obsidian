diff --git a/apps/markdown/tests/obsidian-links.test.ts b/apps/markdown/tests/obsidian-links.test.ts
new file mode 100644
index 0000000..bdee9ee
--- /dev/null
+++ b/apps/markdown/tests/obsidian-links.test.ts
@@ -0,0 +1,75 @@
+import { afterEach, describe, expect, it } from 'vitest'
+import { Editor } from '@tiptap/core'
+import { getDefaults, marked } from 'marked'
+import { VaultStore, type VaultClient } from 'genoffice-obsidian'
+import { buildExtensions } from '../src/renderer/editor/extensions'
+
+const editors: Editor[] = []
+afterEach(() => {
+  for (const e of editors.splice(0)) e.destroy()
+})
+
+const client: VaultClient = {
+  current: async () => ({
+    root: '/v',
+    name: 'v',
+    files: [{ path: 'Home.md' }, { path: 'Plan.md' }],
+    truncated: false,
+  }),
+  pick: async () => null,
+  detect: async () => null,
+  close: async () => {},
+  readText: async () => '# Plan',
+  readImage: async () => null,
+  absolutePath: async (p) => `/v/${p}`,
+  createNote: async (p) => `/v/${p}`,
+  onChanged: () => () => {},
+}
+
+function open(md: string): Editor {
+  marked.setOptions(getDefaults())
+  const editor = new Editor({
+    extensions: buildExtensions({
+      slashController: { onOpen() {}, onUpdate() {}, onKeyDown: () => false, onClose() {} },
+      slashItems: () => [],
+      obsidian: { store: new VaultStore(client), openPath: () => {} },
+    }),
+    content: '',
+  })
+  editors.push(editor)
+  editor.commands.setContent(md, { contentType: 'markdown' })
+  return editor
+}
+
+const count = (e: Editor, type: string) =>
+  (JSON.stringify(e.getJSON()).match(new RegExp(`"type":"${type}"`, 'g')) ?? []).length
+
+describe('Obsidian links in the GenOffice editor', () => {
+  it.each([
+    'See [[Plan]], [[Plan#Goals|goals]] and [[#Intro]].',
+    '![[Plan#Goals]]\n\n![[diagram.png|300]]',
+    '# Heading with [[Home]]\n\n- [ ] task [[Plan]]\n- [x] done ![[pic.png]]',
+    '**bold [[Home]]** and *[[Plan|it]]* and `[[code]]`',
+    // GenOffice pads table columns on save; the input is already in that shape
+    '| Note | Link               |\n| ---- | ------------------ |\n| a    | [[Plan\\|the plan]] |',
+    'Math $x^2$ next to [[Plan]] and a [real link](https://example.com).',
+    '```js\nconst a = "[[not a link]]"\n```',
+    'Plain [brackets] and [1] stay as typed next to [[Home]].',
+  ])('round-trips %j', (md) => {
+    const editor = open(md)
+    expect(editor.getMarkdown().trimEnd()).toBe(md)
+    // and a second pass is stable
+    expect(open(editor.getMarkdown()).getMarkdown().trimEnd()).toBe(md)
+  })
+
+  it('makes nodes where links stand alone and leaves code alone', () => {
+    const editor = open('[[Plan]] ![[pic.png]] `[[x]]`\n\n```\n[[y]]\n```')
+    expect(count(editor, 'wikiLink')).toBe(1)
+    expect(count(editor, 'wikiEmbed')).toBe(1)
+  })
+
+  it('keeps table links as nodes', () => {
+    const editor = open('| a |\n| --- |\n| [[Plan\\|p]] |')
+    expect(count(editor, 'wikiLink')).toBe(1)
+  })
+})
